<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <EditTextPreference
        android:title="@string/pref_port"
        android:key="pref_port"
        android:summary="@string/pref_port_summ"
        android:defaultValue="2221"
        android:inputType="number"/>
    <CheckBoxPreference
        android:title="@string/pref_anon"
        android:key="perf_anon"
        android:summary="@string/pref_anon_summ"
        android:defaultValue="true"/>
    <EditTextPreference
        android:title="@string/pref_userid"
        android:key="pref_userid"
        android:summary="@string/pref_userid_summ"
        android:defaultValue="android"/>
    <EditTextPreference
        android:title="@string/pref_pass"
        android:key="pref_password"
        android:summary="@string/pref_pass_summ"
        android:defaultValue="android"
        android:inputType="textPassword"/>
    <CheckBoxPreference
        android:title="@string/pref_ftps"
        android:key="perf_ftps"
        android:summary="@string/pref_ftps_summ"
        android:defaultValue="false"/>
    <ListPreference
        android:entries="@array/pref_ssl_mode"
        android:title="@string/pref_ssl_mode"
        android:key="pref_ssl_mode"
        android:summary="@string/pref_ssl_mode_summ"
        android:defaultValue="@string/pref_ssl_mode_default"
        android:entryValues="@array/pref_ssl_mode_values"/>
    <ListPreference
        android:entries="@array/pref_mount_points"
        android:title="@string/pref_mount"
        android:key="pref_mount"
        android:summary="@string/pref_mount_summ"
        android:defaultValue="@string/pref_mount_default"
        android:entryValues="@array/pref_mount_point_values"/>
    <CheckBoxPreference
        android:title="@string/pref_read_only"
        android:key="pref_read_only"
        android:summary="@string/pref_read_only_summ"
        android:defaultValue="false"/>
    <ListPreference
        android:entries="@array/pref_theme"
        android:title="@string/lbl_theme"
        android:key="pref_theme"
        android:summary="@string/lbl_theme_summ"
        android:defaultValue="0"
        android:entryValues="@array/pref_theme_values"/>
    <CheckBoxPreference
        android:title="@string/lbl_show_password"
        android:key="pref_show_password"
        android:summary="@string/lbl_show_password_summ"
        android:defaultValue="true"/>
</PreferenceScreen>
