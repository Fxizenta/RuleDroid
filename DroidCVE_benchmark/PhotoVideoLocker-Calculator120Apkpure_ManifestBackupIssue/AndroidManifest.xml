<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="12"
    android:versionName="12.0"
    package="smart.calculator.gallerylock"
    platformBuildVersionCode="25"
    platformBuildVersionName="7.1.1">
    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="21"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.GET_TASKS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <meta-data
        android:name="android.support.VERSION"
        android:value="25.3.1"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE"/>
    <permission
        android:name="smart.calculator.gallerylock.permission.C2D_MESSAGE"
        android:protectionLevel="signature"/>
    <uses-permission android:name="smart.calculator.gallerylock.permission.C2D_MESSAGE"/>
    <application
        android:theme="@style/CustomTheme"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:name="smart.calculator.gallerylock.MyApplication"
        android:manageSpaceActivity="smart.calculator.gallerylock.CalculatorActivity"
        android:allowBackup="true"
        android:largeHeap="true">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"/>
        <activity
            android:theme="@android:style/Theme.Translucent"
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="smallestScreenSize|screenSize|uiMode|screenLayout|orientation|keyboardHidden|keyboard"/>
        <activity
            android:theme="@style/ThemeNoActionBar"
            android:label="Secret Locker"
            android:name="smart.calculator.gallerylock.MainActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:name="smart.calculator.gallerylock.AlbumViewerActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Picture Albums"
            android:name="com.custompicturesgallery.NewImageAlbumActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Pictures"
            android:name="com.custompicturesgallery.NewImagePhotoActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Video Albums"
            android:name="com.custovideogallery.NewVideoAlbumActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Videos"
            android:name="com.custovideogallery.NewVidePhotoActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/CustomTheme.Statusbar.Transcluent"
            android:name="smart.calculator.gallerylock.ImageViewerActivity"
            android:configChanges="screenSize|orientation"/>
        <activity
            android:label="Move Files"
            android:name="smart.calculator.gallerylock.MoveActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/CustomTheme.Statusbar.Transcluent.transparent"
            android:label="Video Player"
            android:name="smart.calculator.gallerylock.PlayVideoActivity"
            android:screenOrientation="fullSensor"
            android:configChanges="screenSize|orientation"/>
        <activity
            android:label="Password Recovery"
            android:name="smart.calculator.gallerylock.ResetActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/CustomThemeNoActionBar.TranparentBg"
            android:name="secret.applock.AppLockActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/CustomTheme.Statusbar.Transcluent"
            android:name="secret.applock.SetAppPwdActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:theme="@style/CustomTheme.Statusbar.Transcluent"
            android:name="smart.calculator.gallerylock.CalculatorActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="secret.applock.BackGroundsActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Calculator App Protection"
            android:name="smart.calculator.gallerylock.DeviceAdmActivity"
            android:screenOrientation="portrait"/>
        <service
            android:name="secret.applock.MyAppLockService"
            android:enabled="true"/>
        <service
            android:name="secret.applock.HelperService"
            android:enabled="true"/>
        <service android:name="com.bg.processes.ClearCacheService"/>
        <receiver
            android:name="secret.applock.SureBootReciever"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="sure.unstoppable.service"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <activity
            android:theme="@style/CustomTheme.Statusbar.Transcluent"
            android:name="smart.calculator.gallerylock.SetAppPasswordActivity"
            android:excludeFromRecents="false"
            android:screenOrientation="portrait"
            android:noHistory="true"/>
        <activity
            android:label="Password Recovery"
            android:name="smart.calculator.gallerylock.SetEmailActivity"
            android:screenOrientation="portrait"/>
        <receiver
            android:name="com.deviceadmin.MyAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/policies"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>
        <activity
            android:theme="@style/CustomTheme"
            android:label="@string/title_activity_setting"
            android:name="smart.calculator.gallerylock.SettingActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Intruder Selfie"
            android:name="smart.calculator.gallerylock.AppIntruderActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Intruder Settings"
            android:name="smart.calculator.gallerylock.IntruderSettingActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Intruder Selfie"
            android:name="smart.calculator.gallerylock.ExpandIntruderActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Fake Cover"
            android:name="smart.calculator.gallerylock.AppLockFakeCoverActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:label="Fake Cover"
            android:name="smart.calculator.gallerylock.ApplockFakeCoverTrialActivity"
            android:screenOrientation="portrait"/>
        <receiver android:name="secret.applock.AlarmReciever"/>
        <receiver
            android:name="secret.applock.MyPackageReceiver"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <action android:name="android.intent.action.PACKAGE_REMOVED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>
        <activity
            android:theme="@style/CustomThemeNoActionBar.TranparentBg"
            android:name="secret.applock.NewAppActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="screenLayout|orientation|keyboard"
            android:noHistory="true"/>
        <receiver
            android:name="smart.calculator.gallerylock.WifiBtReceiver"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED"/>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED"/>
            </intent-filter>
        </receiver>
        <activity
            android:label="@string/app_name"
            android:name="smart.calculator.gallerylock.ShareImportActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:noHistory="true">
            <intent-filter>
                <action android:name="ACTION_LOCK_FROM_SHARE_ACTIVITY"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/Alp_42447968.Theme.Dialog.Light"
            android:name="secret.applock.lockpattern.LockPatternActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:noHistory="true"/>
        <service
            android:label="@string/app_name"
            android:name="secret.applock.WindowChangeDetectingService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilityservice"/>
        </service>
        <provider
            android:name="android.support.v4.content.FileProvider"
            android:exported="false"
            android:authorities="smart.calculator.gallerylock.PlayVideoActivity"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fiprovider"/>
        </provider>
        <receiver
            android:name="com.google.android.gms.measurement.AppMeasurementReceiver"
            android:enabled="true"
            android:exported="false"/>
        <receiver
            android:name="com.google.android.gms.measurement.AppMeasurementInstallReferrerReceiver"
            android:permission="android.permission.INSTALL_PACKAGES"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER"/>
            </intent-filter>
        </receiver>
        <service
            android:name="com.google.android.gms.measurement.AppMeasurementService"
            android:enabled="true"
            android:exported="false"/>
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:permission="com.google.android.c2dm.permission.SEND"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE"/>
                <category android:name="smart.calculator.gallerylock"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdInternalReceiver"
            android:exported="false"/>
        <service
            android:name="com.google.firebase.iid.FirebaseInstanceIdService"
            android:exported="true">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.INSTANCE_ID_EVENT"/>
            </intent-filter>
        </service>
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:exported="false"
            android:authorities="smart.calculator.gallerylock.firebaseinitprovider"
            android:initOrder="100"/>
        <activity
            android:theme="@style/Theme.IAPTheme"
            android:name="com.google.android.gms.ads.purchase.InAppPurchaseActivity"/>
        <activity
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            android:exported="false"/>
    </application>
</manifest>
