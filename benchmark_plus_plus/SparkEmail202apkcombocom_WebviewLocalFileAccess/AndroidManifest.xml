            android:authorities="com.readdle.spark"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <activity
            android:theme="@style/LightTheme"
            android:label="@string/title_activity_other_imap"
            android:name="com.readdle.spark.ui.auth.MailAccountAuthActivity"
            android:parentActivityName="com.readdle.spark.ui.auth.ConnectToServiceActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.readdle.spark.ui.auth.ConnectToServiceActivity"/>
        </activity>
        <activity
            android:theme="@style/AppTheme"
            android:name="com.readdle.spark.ui.threadviewer.ThreadViewerTextNodeActivity"/>
